{
  "version": 1,
  "model": {
    "provider": "openai",
    "id": "gpt-4.1-mini"
  },
  "favorites": [
    {
      "provider": "openai",
      "id": "gpt-4.1-mini"
    }
  ],
  "shortcuts": {
    "optimize": "ctrl+\\",
    "view": null,
    "dismiss": null,
    "selectModel": null,
    "cycleModel": null,
    "restore": null
  },
  "timeoutMs": 60000,
  "context": {
    "maxMessages": 12,
    "maxChars": 16000
  },
  "maxDraftChars": 16000,
  "maxOutputTokens": 2048,
  "projectContext": {
    "enabled": true,
    "maxChars": 28000,
    "instructionsMaxChars": 16000,
    "instructionsOnFollowUp": false,
    "skillsMaxChars": 6000,
    "referencedDirectories": {
      "enabled": true,
      "maxReferences": 8
    },
    "tree": {
      "enabled": true,
      "maxChars": 4000,
      "maxDepth": 2,
      "maxEntriesPerDirectory": 20,
      "maxEntries": 120,
      "maxScannedEntries": 2000,
      "timeoutMs": 200
    }
  }
}
