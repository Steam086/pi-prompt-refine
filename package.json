{
  "name": "pi-prompt-refine",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Rewrite a draft against the current conversation and review it before sending it to the Pi agent.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steam086/pi-prompt-refine.git"
  },
  "homepage": "https://github.com/Steam086/pi-prompt-refine#readme",
  "bugs": { "url": "https://github.com/Steam086/pi-prompt-refine/issues" },
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public" },
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompt"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src/**/*.ts",
    "examples/prompt-refine-preferences.json",
    "examples/prompt-refine.json",
    "docs/tui-guide.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.6.0",
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@earendil-works/pi-tui": "^1.6.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "ignore": "^7.0.8"
  }
}
